{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CS50: 编译当前 C 文件",
      "type": "process",
      "command": "/usr/bin/clang",
      "args": [
        "-ferror-limit=1",
        "-gdwarf-4",
        "-ggdb3",
        "-O0",
        "-std=c11",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-gnu-folding-constant",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
        "-Wshadow",
        "-I/Users/yc/Documents/C-Learning/.cs50/include",
        "${file}",
        "-L/Users/yc/Documents/C-Learning/.cs50/lib",
        "-lcs50",
        "-lm",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
